{
  "name": "@sms/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@sms/shared": "workspace:*",
    "hono": "^4.0.0",
    "zod": "^3.22.4",
    "drizzle-orm": "^0.29.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "drizzle-kit": "^0.20.13",
    "wrangler": "^3.24.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1",
    "@types/node": "^20.11.5"
  }
}
