# Authentication Configuration
# IMPORTANT: Never commit real secrets to version control

# JWT Secret (used for signing access tokens)
# In production, set this using: wrangler secret put JWT_SECRET
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-in-production

# Database
# Local D1 database is configured in wrangler.jsonc
# For production, create a D1 database and update wrangler.jsonc
